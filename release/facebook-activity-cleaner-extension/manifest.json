{
  "manifest_version": 3,
  "name": "Facebook Activity Cleaner (Personal Use)",
  "version": "0.1.0",
  "description": "Review and clean up your own Facebook Activity Log with safety-first controls.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "sidePanel"
  ],
  "host_permissions": [
    "https://www.facebook.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*"
      ],
      "js": [
        "contentScript.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Facebook Activity Cleaner"
  }
}
